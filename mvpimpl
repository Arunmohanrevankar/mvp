Presenter

csharp
public class CityPresenter
{
    private readonly ICityView _view;
    private readonly CityRepository _repo;

    public CityPresenter(ICityView view, CityRepository repo)
    {
        _view = view;
        _repo = repo;
    }

    public void SaveCity()
    {
        if (string.IsNullOrWhiteSpace(_view.CityName))
        {
            _view.ShowMessage("INVALID CITY NAME", "E - Val : INVALID DATA");
            _view.FocusCityName();
            return;
        }

        if (_repo.CityExists(_view.CityName))
        {
            _view.ShowMessage("THIS CITY ALREADY EXIST.", "E - Val : DUPLICATE DATA");
            _view.FocusCityName();
            return;
        }

        _repo.AddCity(_view.CityName, _view.StdCode, _view.Tag);
        _view.ClearInputs();
        _view.FocusCityName();
    }
}
