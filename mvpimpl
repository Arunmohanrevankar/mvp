Example MVP Flow (C# WinForms style)
Model

csharp
public class CityRepository
{
    private readonly string _connectionString;
    public CityRepository(string connectionString) => _connectionString = connectionString;

    public bool CityExists(string name)
    {
        using var conn = new NpgsqlConnection(_connectionString);
        conn.Open();
        using var cmd = new NpgsqlCommand("SELECT COUNT(*) FROM City WHERE UPPER(Name)=@name", conn);
        cmd.Parameters.AddWithValue("@name", name.ToUpper());
        return Convert.ToInt32(cmd.ExecuteScalar()) > 0;
    }

    public void AddCity(string name, string std, string tag)
    {
        using var conn = new NpgsqlConnection(_connectionString);
        conn.Open();
        using var cmd = new NpgsqlCommand("INSERT INTO City (Name, Std, Tag) VALUES (@name,@std,@tag)", conn);
        cmd.Parameters.AddWithValue("@name", name.ToUpper());
        cmd.Parameters.AddWithValue("@std", string.IsNullOrEmpty(std) ? (object)DBNull.Value : std);
        cmd.Parameters.AddWithValue("@tag", string.IsNullOrEmpty(tag) ? (object)DBNull.Value : tag);
        cmd.ExecuteNonQuery();
    }
}
