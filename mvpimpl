public partial class CityForm : Form, ICityView
{
    private readonly CityPresenter _presenter;

    public CityForm()
    {
        InitializeComponent();
        var repo = new CityRepository("your-connection-string");
        _presenter = new CityPresenter(this, repo);
    }

    public string CityName => textBox1.Text.Trim();
    public string StdCode => textBox3.Text.Trim();
    public string Tag => textBox2.Text.Trim();

    public void ShowMessage(string message, string title) =>
        MessageBox.Show(message, title);

    public void ClearInputs()
    {
        textBox1.Clear();
        textBox2.Clear();
        textBox3.Clear();
    }

    public void FocusCityName() => textBox1.Focus();

    private void button1_Click(object sender, EventArgs e) =>
        _presenter.SaveCity();
}
✨ Benefits of MVP Here
Testability → You can unit test CityPresenter without UI.

Separation of concerns → SQL logic is isolated in CityRepository.

Maintainability → UI changes don’t affect business rules.

Scalability → Easy to extend with more validation or logging.

