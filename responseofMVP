 # 3\. Model — CityRepository.cs

 Create:

```
Model/CityRepository.cs
```

 Use:

```
using System;
using Npgsql;

namespace DemoApp.Model
{
    public class CityRepository
    {
        private readonly string _connectionString;

        public CityRepository(string connectionString)
        {
            _connectionString = connectionString;
        }

        public bool CityExists(string cityName)
        {
            using (var conn = new NpgsqlConnection(_connectionString))
            {
                conn.Open();

                string sql = @"
                    SELECT COUNT(*)
                    FROM city
                    WHERE UPPER(ct_nm) = UPPER(@cityName)";

                using (var cmd = new NpgsqlCommand(sql, conn))
                {
                    cmd.Parameters.AddWithValue("@cityName", cityName);

                    int count = Convert.ToInt32(cmd.ExecuteScalar());

                    return count > 0;
                }
            }
        }

        public void AddCity(string cityName)
        {
            using (var conn = new NpgsqlConnection(_connectionString))
            {
                conn.Open();

                string sql = @"
                    INSERT INTO city (ct_nm)
                    VALUES (@cityName)";

                using (var cmd = new NpgsqlCommand(sql, conn))
                {
                    cmd.Parameters.AddWithValue("@cityName", cityName);

                    cmd.ExecuteNonQuery();
                }
            }
        }
    }
}
```

 Notice that we're using your actual column:

```
ct_nm
```

 not `Name`.

