 # 5\. Presenter — CityPresenter.cs

 Create:

```
Presenter/CityPresenter.cs
```

```
using DemoApp.Model;
using DemoApp.View;

namespace DemoApp.Presenter
{
    public class CityPresenter
    {
        private readonly ICityView _view;
        private readonly CityRepository _repository;

        public CityPresenter(ICityView view, CityRepository repository)
        {
            _view = view;
            _repository = repository;
        }

        public void AddCity()
        {
            string cityName = _view.CityName.Trim();

            // Validate
            if (string.IsNullOrWhiteSpace(cityName))
            {
                _view.ShowError("Please enter a city name.");
                return;
            }

            // Maximum length from your database
            if (cityName.Length > 200)
            {
                _view.ShowError("City name cannot exceed 200 characters.");
                return;
            }

            try
            {
                // Check duplicate
                if (_repository.CityExists(cityName))
                {
                    _view.ShowError("This city already exists.");
                    return;
                }

                // Insert
                _repository.AddCity(cityName);

                _view.ShowMessage("City added successfully.");

                _view.ClearCityName();
            }
            catch (System.Exception ex)
            {
                _view.ShowError(
                    "Error adding city:\n\n" + ex.Message);
            }
        }
    }
}
```

 Now the responsibility is clean:

 **Presenter validates and controls the operation.**

 **Repository performs the database operation.**

 **Form displays the UI.**

